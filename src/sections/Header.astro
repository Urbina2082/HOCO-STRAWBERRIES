---

import Menu from "../components/Welcome.astro";
---

<header>
  <Menu />
  <div class="icon">
    <img src="/logo.avif" alt="" />
  </div>

  <div class="bott_nva">
    <h1>HOCO <span> <br /> Strawberries</span></h1>
  </div>
  <p>By. Holly and Cookie los pequeños jefes perrunos</p>
  <a href="#Menu"><button>Ver menu</button></a>
</header>

<style>
  header {
    width: 100%;
    height: 100vh;
    text-align: center;
    background-image: url(/grr.avif);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .icon {
    display: none;
  }
  h1 {
    color: #ffffff;
    font-family: "Playfair Display", serif;
    font-size: clamp(3rem, 10vw, 190px);
    text-align: center;
    margin: 45px 10px 25px;
    text-shadow: 0px 0px 52px #ffffff;
    position: relative;
   
  }
 

  h1 span {
    color: #ffffff;
  }

  p {
    color: #ffffffcf;
    margin: 0px 10px;
  }

  button {
    padding: 10px 40px;
    background: #c8005a;
    color: aliceblue;
    border-radius: 25px;
    border: 1px solid #ffffff00;
    font-size: 0.9rem;
    margin: 2rem 0rem;
    box-shadow: 2px 2px 12px 12px #ffffff36;
  }
  @media screen and (max-width: 768px) {
    h1 {
      color: #ffffff;
      font-family: "Playfair Display", serif;
      font-size: clamp(7rem, 10vw, 190px);
      text-align: center;
      margin: 70px 0px 25px;
      line-height: 30px;
      text-shadow: 0px 0px 12px #ffffff;
    }

    .icon {
      display: flex;
      justify-content: center;
       animation:
      pulse-glow 4s ease-in-out infinite,
      float-y 6s ease-in-out infinite;
    }
    img {
      width: 114px;
      height: auto;
      border-radius: 50%;
      box-shadow: 0px 0px 12px 12px #ffffff4a;
    }
   

  @keyframes float-y {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-15px);
    }
  }
    h1 span {
      color: #ffffff;
      font-size: clamp(2rem, 10vw, 190px);
    }

    p {
      color: #ffffffcf;
    }

    button {
      padding: 10px 80px;
      background: #ffffff29;
      color: aliceblue;
      border-radius: 25px;
      border: 1px solid #ffffff;
      font-size: 1.2rem;
    }
  }
</style>
