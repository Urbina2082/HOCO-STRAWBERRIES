---
import InitialSection from "../components/InitialSection.astro";
import { menu } from "../Data/menu";
---

<section id="Menu">
  <!-- Sección del titulo del menú -->
  <InitialSection
    TypeSection="LO QUE MAS PEDIMOS"
    title="Nuestro"
    titlespan="Menú"
    description="Explora ingredientes y precios de cada categoría."
  />

  <!-- Contenedor principal del menú -->
  <div class="menuu" >
    <!-- Botones de las categorías (Smoothies, Aguas, etc) -->
    <div class="butss">
      {menu.map((item) => <button class="tab">{item.name}</button>)}
    </div>
    
    <!-- Aquí se mostrará el contenido del menú seleccionado -->
    <div id="info-menu"></div>
  </div>

</section>

<script define:vars={{ menu }}>
  /**
   * FUNCIÓN: renderMenuItem
   * Convierte datos del menú en código HTML visible
   * 
   * Explicación:
   * - Toma un elemento del menú (ej: "Smoothies & Aguas")
   * - Crea un contenedor principal con clase "info-menu" para los estilos
   * - Dentro muestra el nombre, descripción y todos sus grupos
   * - Cada grupo (ej: "Smoothies", "Aguas") contiene sus items
   * - Cada item muestra nombre, descripción y precio
   */
  function renderMenuItem(menuItem) {
    return `
      <div class="info-menu">
        <div class="info-menu-item">
          <!-- Nombre de la categoría -->
          <h2>${menuItem.name}</h2>
          <!-- Descripción de la categoría -->
          <p>${menuItem.description}</p>
          
          <!-- Grupos dentro de la categoría (Smoothies, Aguas, etc) -->
          ${menuItem.grups
            .map(
              (group) => `
            <div class="sep1">
              <!-- Título del grupo -->
              <h3>${group.title}</h3>
              
              <!-- Todos los productos dentro del grupo -->
              ${group.items
                .map(
                  (item) => `
                <div class="sep2">
                  <!-- Información del producto (nombre + descripción) -->
                  <div class="one">
                    <h5>${item.name}</h5>
                    <p>${item.datails}</p>
                  </div>
                  <!-- Precio del producto -->
                  <div class="two">
                    <span>${item.price}</span>
                  </div>
                </div>
              `
                )
                .join("")}
            </div>
          `
            )
            .join("")}
        </div>
      </div>
    `;
  }

  /**
   * EVENTO: DOMContentLoaded
   * Se ejecuta cuando la página HTML está completamente cargada
   * Explicación: Esperamos a que todo el contenido esté listo antes de agregar interactividad
   */
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Buscamos todos los botones con clase "tab"
    const tabs = document.querySelectorAll(".tab");
    
    // 2. Buscamos el contenedor donde mostraremos el menú
    const grid = document.getElementById("info-menu");

    /**
     * CICLO: Para cada botón (tab)
     * Agregamos un evento de click
     */
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        // Paso 1: Removemos la clase "active" de TODOS los botones
        // (esto quita el color rosa/activo de cualquier botón que lo tenga)
        tabs.forEach((t) => t.classList.remove("active"));
        
        // Paso 2: Agregamos la clase "active" SOLO al botón que hicimos click
        // (esto lo pone de color rosa/activo)
        tab.classList.add("active");

        // Paso 3: Obtenemos el menú correspondiente al botón clickeado
        // (si clickeamos el botón 0 "Smoothies", obtenemos menu[0])
        const menuItem = menu[index];
        
        // Paso 4: Mostramos el contenido del menú generado en la página
        grid.innerHTML = renderMenuItem(menuItem);
      });
    });

    /**
     * INICIALIZACIÓN: Mostrar el primer menú por defecto
     * Cuando carga la página, mostramos automáticamente el primer menú
     * sin que el usuario tenga que hacer click
     */
    if (tabs.length > 0) {
      tabs[0].click(); // Simulamos un click en el primer botón
    }
  });
</script>

<style is:global>
  /* --------------------button------------------  */

  section {
    margin-top: 88px;
    
  }

  .menuu .butss .tab {
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--muted);
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.22s ease;
    font-family: Outfit, sans-serif;
  }

  /* Este boton debe de estar activado solo este en hover por procesamiento */
  .menuu .butss .tab:hover {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
    box-shadow: 0 4px 18px #c8005a4d;
  }

  .menuu .butss .tab.active {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
    box-shadow: 0 4px 18px #c8005a4d;
  }

  /* Estilo y estructuracion del menu  */
  .menuu {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0px 54px;
   
  }

  .menuu .butss {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .info-menu {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 30px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .info-menu-item {
    width: 100%;
  }

  .info-menu-item h2 {
    font-family: Playfair Display, serif;
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .info-menu-item p {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 4px 0 0 0;
  }

  .sep1 {
    margin: 40px 0 0 0;
  }

  .sep1 h3 {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand);
    border-top: 2px solid var(--brand-mid);
    padding-top: 10px;
    margin: 0 0 12px 0;
  }

  .sep2 {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    gap: 15px;
    flex-wrap: wrap;
  }

  .sep2 .one {
    flex: 1;
    min-width: 200px;
  }

  .sep2 .one h5 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    color: var(--text);
  }

  .sep2 .one p {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 5px 0 0 0;
  }

  .sep2 .two {
    text-align: right;
  }

  .sep2 .two span {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--brand);
    display: block;
    line-height: 1.4;
  }



 @media (max-width: 768px) {

   .menuu {
    
    margin: 0px 15px;
   
  }}

</style>
